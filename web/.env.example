# Базовый URL API.
# Пусто по умолчанию => /api и проксирование (Vite dev-proxy локально,
# nginx в production-контейнере). Абсолютный URL backend можно указать,
# если он разрешает CORS.
VITE_API_BASE_URL=

# Куда Vite dev-сервер проксирует API-запросы локально.
VITE_PROXY_TARGET=http://localhost:8080
